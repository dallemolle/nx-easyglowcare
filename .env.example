# Copie para .env.local e ajuste. Nunca commite .env.local.
# Os valores abaixo apontam para o ambiente local (pnpm db:up).

# --- Banco ------------------------------------------------------------------
# App (driver @neondatabase/serverless). Local: proxy do Neon no Docker (host db.localtest.me → 127.0.0.1).
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/easyglowcare
# Migrations e seed (conexão TCP direta).
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/easyglowcare
# Testes (Vitest). Banco separado, truncado a cada teste.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyglowcare_test
# Neon (preview/produção; injetadas pela integração Vercel ↔ Neon):
# DATABASE_URL=postgres://USER:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://USER:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- App --------------------------------------------------------------------
# URL pública do app (links em mensagens, PWA).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Segurança (a partir do 0B) ---------------------------------------------
# Obrigatória; gere com: openssl rand -base64 32
SESSION_SECRET=
# Senha usada pelo seed para criar a equipe de exemplo (opcional; sem ela o seed gera e imprime uma).
SEED_STAFF_PASSWORD=
# Chave AES-GCM para colunas sensíveis (base64, 32 bytes).
DATA_ENCRYPTION_KEY=
# Token exigido nas rotas /api/cron/* (0C).
CRON_SECRET=

# --- Arquivos (Vercel Blob) -------------------------------------------------
# Só fora da Vercel; na Vercel usar OIDC.
BLOB_READ_WRITE_TOKEN=

# --- Web Push (0D) ----------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Provedores (adapters; 0C) ----------------------------------------------
MESSAGING_PROVIDER=console
PAYMENT_PROVIDER=mock
SIGNATURE_PROVIDER=internal
